{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@value-terminal/types": ["packages/types/src"],
      "@value-terminal/domain": ["packages/domain/src"],
      "@value-terminal/valuation-engine": ["packages/valuation-engine/src"],
      "@value-terminal/data-connectors": ["packages/data-connectors/src"],
      "@value-terminal/agent-contracts": ["packages/agent-contracts/src"]
    }
  }
}
