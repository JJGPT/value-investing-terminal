# Safe local template. Do not commit real provider keys.

# API runtime
APP_NAME="Value Investing Terminal API"
APP_VERSION="0.0.0"
APP_ENV="development"
CORS_ORIGINS="http://localhost:3000"

# Web runtime
# Only NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
API_BASE_URL="http://localhost:8000"

# Local persistence
VALUE_TERMINAL_DB_PATH="apps/api/data/value_terminal.db"
SNAPSHOT_STALE_AFTER_SECONDS="86400"

# Alpaca market data: backend-only keys, never NEXT_PUBLIC_.
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_DATA_BASE_URL="https://data.alpaca.markets"
SECURITY_SEARCH_CACHE_TTL_SECONDS="300"
SECURITY_LOOKUP_CACHE_TTL_SECONDS="900"
MARKET_SNAPSHOT_CACHE_TTL_SECONDS="30"

# Financial Modeling Prep fundamentals: backend-only key.
FMP_API_KEY=""
FMP_BASE_URL="https://financialmodelingprep.com/stable"
FUNDAMENTALS_PROFILE_CACHE_TTL_SECONDS="3600"
FUNDAMENTALS_INCOME_STATEMENT_CACHE_TTL_SECONDS="3600"
FUNDAMENTALS_BALANCE_SHEET_CACHE_TTL_SECONDS="3600"
FUNDAMENTALS_CASH_FLOW_CACHE_TTL_SECONDS="3600"
FUNDAMENTALS_KEY_METRICS_CACHE_TTL_SECONDS="3600"
COMPUTED_METRICS_CACHE_TTL_SECONDS="900"

# Reserved future infrastructure. Leave blank in Phase 5D local setup.
DATABASE_URL=""
REDIS_URL=""
OBJECT_STORAGE_URL=""
SEC_USER_AGENT=""
NEWS_API_KEY=""
OPENAI_API_KEY=""
